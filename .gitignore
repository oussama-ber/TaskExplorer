# .gitignore for TaskExplorer (Monorepo with .NET and React)

# macOS
.DS_Store

# .NET
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.idea/
.nuget/

# ASP.NET Core secrets & local config overrides
# Run: dotnet user-secrets set "JwtSettings:Secret" "..." --project TaskExplorer.API
# Run: dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..." --project TaskExplorer.API
appsettings.Development.json
appsettings.*.local.json

# Node.js / React
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
*.env.local

# Secrets
usersecrets.json

# Docker
.dockerignore
